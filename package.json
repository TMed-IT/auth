{
	"name": "mahora-auth",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "dotenvx run -- next build",
		"lint": "next lint",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"preview": "dotenvx run -- opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"db:schema": "wrangler d1 execute DB --local --file=./schema.sql",
		"db:reset": "wrangler d1 execute DB --local --command=\"DROP TABLE IF EXISTS users\" && wrangler d1 execute DB --local --file=./schema.sql",
		"db:list": "wrangler d1 execute DB --local --command=\"SELECT * FROM users\""
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.11.1",
		"@radix-ui/react-slot": "^1.2.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.23.24",
		"iron-webcrypto": "^1.2.1",
		"lucide-react": "^0.552.0",
		"next": "15.4.6",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@tailwindcss/postcss": "^4.1.17",
		"@types/node": "^20.19.24",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@dotenvx/dotenvx": "^1.40.0",
		"eslint": "^9.39.1",
		"eslint-config-next": "15.4.6",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"wrangler": "^4.46.0"
	},
	"packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
